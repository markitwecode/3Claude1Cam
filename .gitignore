.venv/
.venv-mlx/
__pycache__/
.DS_Store
engine/.locks/
engine/logs/
engine/media/
media/

# Bring-your-own assets: never commit voices, music or third-party references
engine/assets/voice/
engine/assets/music/
engine/reference/*
